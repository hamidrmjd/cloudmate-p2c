# Export these values in your shell or service manager; .env is not auto-loaded.
CLOUDMATE_TOKEN=replace-with-a-long-random-secret
CLOUDMATE_BIND=127.0.0.1
PORT=8787
# Optional allowed dashboard origin, without trailing slash:
# CLOUDMATE_ORIGIN=https://your-dashboard.example.com
# Optional absolute checkout directory:
# CLOUDMATE_DATA=/var/lib/cloudmate-p2c
